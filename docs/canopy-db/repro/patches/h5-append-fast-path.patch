+/// Prototype: the rightmost leaf of the tree, dirty in this transaction, so that keys past the
+/// last key of the tree go straight to it.
+#[derive(Default, Debug)]
+pub(crate) struct AppendHint {
+    leaf: Option<PageId>,
+    disabled: bool,
+}
+
+enum Append {
+    Done,
+    /// An append the fast path cannot do: take the full path, then find the rightmost leaf again.
+    Fallback,
+    /// Not an append: take the full path and stop trying in this tree instance.
+    NotAppend,
+    /// The fast path does not apply (e.g. overflow value): take the full path.
+    Skip,
+}
+
+fn append_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("CANOPY_APPEND").map_or(true, |v| v != "0"))
+}
